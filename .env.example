# MaatriSaarthi Firebase Configuration Template
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: HTTPS endpoint that sends SMS/WhatsApp alerts (e.g. a Cloud Function
# wrapping an SMS provider). It receives POST {channel, to, text, messageType, rchId}
# with the Firebase ID token as a Bearer header. Leave empty and the app reports
# every alert as NOT SENT instead of pretending it was delivered.
VITE_ALERT_GATEWAY_URL=
