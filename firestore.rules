rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/user_accounts/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    // Approved ASHA workers, PHC doctors and ward officers
    function isStaff() {
      return hasProfile()
        && profile().approved == true
        && profile().role in ['ASHA_WORKER', 'PHC_DOCTOR', 'WARD_OFFICER'];
    }

    function isApprovedRole(role) {
      return hasProfile() && profile().approved == true && profile().role == role;
    }

    // Doctors and ward officers see the whole cohort; ASHA workers only their assigned mothers
    function isClinicalLead() {
      return isApprovedRole('PHC_DOCTOR') || isApprovedRole('WARD_OFFICER');
    }

    function isMotherAccount() {
      return hasProfile() && profile().role == 'MOTHER';
    }

    function visitCodePath(beneficiaryId) {
      return /databases/$(database)/documents/visit_codes/$(beneficiaryId);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- User accounts ----------
    // Users create their own profile. Mothers are auto-approved; staff roles must
    // start unapproved and are approved by a Ward Officer (or in the Firebase console).
    // Nobody can change their own role or approval flag.
    match /user_accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isApprovedRole('WARD_OFFICER'));

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['MOTHER', 'ASHA_WORKER', 'PHC_DOCTOR', 'WARD_OFFICER']
        && request.resource.data.approved == (request.resource.data.role == 'MOTHER');

      allow update: if signedIn() && (
        (request.auth.uid == uid && !changedKeys().hasAny(['uid', 'role', 'approved']))
        || isApprovedRole('WARD_OFFICER')
      );

      allow delete: if isApprovedRole('WARD_OFFICER');
    }

    // ---------- Maternal beneficiary records ----------
    // Doctors and ward officers can read and write the cohort (and assign ASHA workers).
    // An ASHA worker can read and write only mothers assigned to her (assignedAshaUid),
    // and new mothers she registers are assigned to her. A mother can read only the
    // record she owns (ownerUid), create it at sign-up, and update only her consent.
    match /mothers/{beneficiaryId} {
      function ownerUnchanged() {
        return !('ownerUid' in resource.data)
          || request.resource.data.ownerUid == resource.data.ownerUid;
      }

      allow read: if isClinicalLead()
        || (isApprovedRole('ASHA_WORKER') && resource.data.assignedAshaUid == request.auth.uid)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isClinicalLead()
        || (isApprovedRole('ASHA_WORKER') && request.resource.data.assignedAshaUid == request.auth.uid)
        || (isMotherAccount() && request.resource.data.ownerUid == request.auth.uid);

      allow update: if (isClinicalLead() && ownerUnchanged())
        || (isApprovedRole('ASHA_WORKER')
          && resource.data.assignedAshaUid == request.auth.uid
          && request.resource.data.assignedAshaUid == request.auth.uid
          && ownerUnchanged())
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && changedKeys().hasOnly(['dpdpConsent', 'lastSyncedAt']));

      allow delete: if isApprovedRole('WARD_OFFICER');
    }

    // ---------- Clinical logs ----------
    // recordedByUid is the audit trail for who entered a reading: staff can only write
    // their own uid, and an ASHA worker's entry can never be rewritten afterwards
    // (only the sync bookkeeping fields may change on a retry).
    match /vitals_logs/{vitalId} {
      allow read: if isClinicalLead()
        || (isApprovedRole('ASHA_WORKER') && resource.data.recordedByUid == request.auth.uid);
      allow create: if isStaff() && request.resource.data.recordedByUid == request.auth.uid;
      allow update: if isClinicalLead()
        || (isApprovedRole('ASHA_WORKER')
          && resource.data.recordedByUid == request.auth.uid
          && request.resource.data.recordedByUid == request.auth.uid
          && changedKeys().hasOnly(['syncedAt', 'syncStatus']));
      allow delete: if isApprovedRole('WARD_OFFICER');
    }

    // ---------- Visit audit log ----------
    // One row per QR scan / PIN unlock / vitals entry / registration by an ASHA worker.
    // ashaUid must be the caller and syncedAt must be the server's clock, so a worker
    // cannot log a visit as someone else or backdate when it reached the server.
    // Rows are write-once: no update, and only a Ward Officer can delete.
    match /visit_logs/{visitId} {
      allow read: if isClinicalLead()
        || (isApprovedRole('ASHA_WORKER') && resource.data.ashaUid == request.auth.uid);
      // motherConfirmed may only be true when the mother really confirmed this ASHA's code
      allow create: if isApprovedRole('ASHA_WORKER')
        && request.resource.data.ashaUid == request.auth.uid
        && request.resource.data.syncedAt == request.time
        && (request.resource.data.get('motherConfirmed', false) == false
          || (exists(visitCodePath(request.resource.data.beneficiaryId))
            && get(visitCodePath(request.resource.data.beneficiaryId)).data.ashaUid == request.auth.uid
            && get(visitCodePath(request.resource.data.beneficiaryId)).data.confirmedAt != null));
      allow update: if false;
      allow delete: if isApprovedRole('WARD_OFFICER');
    }

    match /prescriptions/{rxId} {
      allow read: if isClinicalLead();
      allow create, update: if isApprovedRole('PHC_DOCTOR');
      allow delete: if isApprovedRole('WARD_OFFICER');
    }

    // ---------- One-time visit codes (second factor for an ASHA visit) ----------
    // Document id = mothers/{id}. The assigned ASHA worker issues a code (a new code replaces
    // the old one) and can read it back. The mother's account can only confirm: the update must
    // carry the same code, arrive before it expires, and change nothing else. She cannot read it.
    match /visit_codes/{beneficiaryId} {
      function motherRecord() {
        return get(/databases/$(database)/documents/mothers/$(beneficiaryId)).data;
      }

      allow read: if isClinicalLead()
        || (isApprovedRole('ASHA_WORKER') && resource.data.ashaUid == request.auth.uid);

      allow create, update: if isApprovedRole('ASHA_WORKER')
        && request.resource.data.ashaUid == request.auth.uid
        && motherRecord().assignedAshaUid == request.auth.uid
        && request.resource.data.confirmedAt == null
        && request.resource.data.expiresAt <= request.time.toMillis() + 960000;

      allow update: if signedIn()
        && motherRecord().ownerUid == request.auth.uid
        && resource.data.confirmedAt == null
        && request.time.toMillis() <= resource.data.expiresAt
        && changedKeys().hasOnly(['confirmedCode', 'confirmedAt', 'confirmedByUid'])
        && request.resource.data.confirmedCode == resource.data.code
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.confirmedByUid == request.auth.uid;
    }

    // ---------- Reserved collections ----------
    match /sync_mutations/{mutationId} {
      allow read, write: if isStaff();
    }

    match /emergency_alerts/{alertId} {
      allow read: if isStaff();
      allow create: if hasProfile();
    }

    // Everything else is denied by default.
  }
}
